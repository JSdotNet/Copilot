{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "create_pull_request|powershell|bash",
        "bash": "\"${PLUGIN_ROOT}/scripts/pr-jsdotnet-pre-tool.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/scripts/pr-jsdotnet-pre-tool.ps1\"",
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "matcher": "create_pull_request|powershell|bash",
        "bash": "\"${PLUGIN_ROOT}/scripts/pr-jsdotnet-post-tool-failure.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/scripts/pr-jsdotnet-post-tool-failure.ps1\"",
        "timeoutSec": 10
      }
    ]
  }
}
