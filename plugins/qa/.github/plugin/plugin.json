{
  "name": "qa",
  "description": "Copilot plugin for runtime QA validation — run Aspire-orchestrated apps, drive Playwright browser scenarios with evidence for each, and monitor Aspire logs/traces during the test session.",
  "version": "0.3.0",
  "author": {
    "name": "Job Schepers"
  },
  "license": "MIT",
  "keywords": [
    "copilot",
    "agent",
    "qa",
    "testing",
    "aspire",
    "playwright",
    "e2e",
    "validation",
    "observability"
  ],
  "mcpServers": {
    "aspire": {
      "type": "stdio",
      "command": "aspire",
      "args": [
        "agent",
        "mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  },
  "agents": "agents/",
  "skills": "skills/",
  "hooks": "hooks.json"
}
